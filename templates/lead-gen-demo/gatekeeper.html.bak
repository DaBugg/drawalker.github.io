        <!-- CTA + FAQ -->
        <section class="section cta-faq section-snap section-full" id="apply">
            <div class="container">
                <div class="cta-faq-grid">
                    <!-- Form Side -->
                    <div class="cta-side">
                        <h2 class="animate-on-scroll">See if you're a good fit</h2>
                        <p class="cta-sub animate-on-scroll delay-1">15 minutes. We'll show you where you're losing
                            leads.</p>

                        <!-- Step Indicators -->
                        <div class="form-steps animate-on-scroll delay-2">
                            <div class="step-indicator active" data-step="1"></div>
                            <div class="step-indicator" data-step="2"></div>
                            <div class="step-indicator" data-step="3"></div>
                        </div>

                        <!-- Step 1: Form -->
                        <div class="form-card animate-on-scroll delay-2" id="formStep">
                            <form id="qualifyForm" novalidate>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="name">Name</label>
                                        <input type="text" id="name" name="name" placeholder="Your name" required>
                                        <div class="error-message" id="nameError">Please enter your name</div>
                                    </div>
                                    <div class="form-group">
                                        <label for="email">Email</label>
                                        <input type="email" id="email" name="email" placeholder="you@company.com"
                                            required>
                                        <div class="error-message" id="emailError">Please enter a valid email address
                                        </div>
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="phone">Phone</label>
                                        <input type="tel" id="phone" name="phone" placeholder="5551234567"
                                            pattern="[0-9]*" inputmode="numeric" required>
                                        <div class="error-message" id="phoneError">Please enter a valid phone number
                                            (numbers only)</div>
                                    </div>
                                    <div class="form-group">
                                        <label for="revenue">Monthly Revenue</label>
                                        <select id="revenue" name="revenue" required>
                                            <option value="">Select range</option>
                                            <option value="under75">Under $75k</option>
                                            <option value="75to100">$75k to $100k</option>
                                            <option value="100to180">$100k to $180k</option>
                                            <option value="180plus">$180k+</option>
                                        </select>
                                        <div class="error-message" id="revenueError">Please select your revenue range
                                        </div>
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group" style="grid-column: 1 / -1;">
                                        <label for="leads">Leads Per Month</label>
                                        <select id="leads" name="leads" required>
                                            <option value="">Select range</option>
                                            <option value="under25">Under 25</option>
                                            <option value="25to50">25 to 50</option>
                                            <option value="50to100">50 to 100</option>
                                            <option value="100plus">100+</option>
                                        </select>
                                        <div class="error-message" id="leadsError">Please select your lead volume</div>
                                    </div>
                                </div>

                                <!-- Legal Compliance -->
                                <div class="legal-checkbox">
                                    <input type="checkbox" id="consent" name="consent" required>
                                    <label for="consent">I agree to the <a href="#" onclick="openModal('privacyModal'); return false;">Privacy
                                            Policy</a> and consent to receive communications about my inquiry. I can opt
                                        out anytime.</label>
                                </div>
                                <div class="error-message" id="consentError" style="margin-left: 30px;">Please agree to
                                    continue</div>

                                <button type="submit" class="btn btn-primary hoverable">Check If I Qualify</button>
                            </form>
                            <p class="form-note">Free. No commitment.</p>
                        </div>

                        <!-- Step 2: Calendar Booking -->
                        <div class="calendar-step" id="calendarStep">
                            <h4>Great! Pick a date and time.</h4>
                            <p>Choose when works best for your 15-minute call.</p>

                            <div class="calendar-nav">
                                <button type="button" id="prevMonth" class="hoverable">&larr; Prev</button>
                                <span class="calendar-month" id="calendarMonth">February 2026</span>
                                <button type="button" id="nextMonth" class="hoverable">Next &rarr;</button>
                            </div>

                            <div class="calendar-grid" id="calendarGrid">
                                <!-- Calendar days will be generated by JS -->
                            </div>

                            <div id="timeSlotContainer" style="display: none;">
                                <p style="text-align: center; margin-bottom: 16px; color: var(--text-gray);">Available
                                    times for <span id="selectedDateText"></span>:</p>
                                <div class="time-slots" id="timeSlots">
                                    <div class="time-slot hoverable" data-time="09:00">9:00 AM</div>
                                    <div class="time-slot hoverable" data-time="10:00">10:00 AM</div>
                                    <div class="time-slot hoverable" data-time="11:00">11:00 AM</div>
                                    <div class="time-slot hoverable" data-time="13:00">1:00 PM</div>
                                    <div class="time-slot hoverable" data-time="14:00">2:00 PM</div>
                                    <div class="time-slot hoverable" data-time="15:00">3:00 PM</div>
                                </div>
                                <button type="button" class="btn btn-primary hoverable" id="confirmBooking"
                                    style="width: 100%;">Confirm Booking</button>
                            </div>
                        </div>

                        <!-- Step 3: Confirmation -->
                        <div class="confirmation-step" id="confirmationStep">
                            <div class="confirmation-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                                    <polyline points="22 4 12 14.01 9 11.01" />
                                </svg>
                            </div>
                            <h4>You're all set!</h4>
                            <p>Check your email for a calendar invite.</p>

                            <div class="confirmation-details">
                                <div class="detail-row">
                                    <span class="detail-label">Date</span>
                                    <span class="detail-value" id="confirmDate">-</span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Time</span>
                                    <span class="detail-value" id="confirmTime">-</span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Duration</span>
                                    <span class="detail-value">15 minutes</span>
                                </div>
                            </div>

                            <p style="font-size: 14px;">We'll call you at the number you gave us.</p>
                        </div>

                        <!-- Not qualified message (hidden - redirects) -->
                        <div class="not-qualified" id="notQualified"></div>

                        <div class="guarantee-badge animate-on-scroll delay-3">
                            <span>✓</span> 15+ <span class="tooltip"
                                data-tip="They have the budget, the need, and the power to make a decision.">qualified</span>
                            meetings in 60 days or <span class="tooltip"
                                data-tip="Our fee is waived. Ad spend is separate.">you don't pay</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ SECTION -->
        <section class="section faq-section section-snap" id="faq">
            <div class="container">
                <div class="section-header">
                    <h2 class="section-title animate-on-scroll">Common Questions</h2>
                    <p class="section-sub animate-on-scroll delay-1">Everything you need to know</p>
                </div>
                <div class="faq-grid animate-on-scroll delay-2">
                    <div class="faq-item">
                        <div class="faq-question">How much does it cost?</div>
                        <div class="faq-answer">You pay a monthly fee plus your ad spend. If you close just one or two deals, you've already covered the cost.</div>
                    </div>
                    <div class="faq-item">
                        <div class="faq-question">I already use a CRM</div>
                        <div class="faq-answer">No problem. We work on top of what you have. We send the good leads right to your current system.</div>
                    </div>
                    <div class="faq-item">
                        <div class="faq-question">What if it doesn't work?</div>
                        <div class="faq-answer">15+ booked calls in 60 days or you don't pay us. Simple as that.</div>
                    </div>
                    <div class="faq-item">
                        <div class="faq-question">Will leads know it's automated?</div>
                        <div class="faq-answer">No. Our messages sound like real people. Your team still does the actual calls and closes the deals.</div>
                    </div>
                    <div class="faq-item">
                        <div class="faq-question">I don't run ads</div>
                        <div class="faq-answer">That's fine. This works with any way you get leads - website, referrals, Google, anything.</div>
                    </div>
                    <div class="faq-item">
                        <div class="faq-question">When will I see results?</div>
                        <div class="faq-answer">Your leads get faster replies within 24 hours. Most people start seeing booked calls in the first 2 weeks.</div>
                    </div>
                </div>
            </div>
        </section>

